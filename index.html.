<script>
(()=>{const cv=document.querySelector('#map'),ctx=cv.getContext('2d'),W=cv.width,H=cv.height,urls=['https://raw.githubusercontent.com/datasets/geo-ne-admin1/main/data/admin1.geojson','https://datahub.io/core/geo-ne-admin1/_r/-/data/admin1.geojson'],colors=['#66e6b5','#ff6b6b','#ffb84d','#9b91ff'],factions=['You','Crimson','Amber','Indigo'];let cs=[],sel=-1,ended=false,paused=true,turn=1,gold=100,truce=[0,0,0,0],zoom=1,panX=0,panY=0,pointers=new Map(),gesture=null,lastTick=Date.now(),aiClock=0,choosingStart=false,matchSeconds=0,uiClock=0,drawClock=0,neighborGrid=new Map(),neighborCache=new Map();const $=id=>document.getElementById(id),say=t=>$('message').textContent=t;
function project(lon,lat){return[(lon+180)/360*W,(90-lat)/180*H]}function polys(g){return !g?[]:g.type==='Polygon'?[g.coordinates]:g.type==='MultiPolygon'?g.coordinates:[]}function bounds(ps){let ax=999,bx=-999,ay=999,by=-999;ps.forEach(p=>p.forEach(r=>r.forEach(q=>{ax=Math.min(ax,q[0]);bx=Math.max(bx,q[0]);ay=Math.min(ay,q[1]);by=Math.max(by,q[1])})));return{minX:ax,maxX:bx,minY:ay,maxY:by,cx:(ax+bx)/2,cy:(ay+by)/2}}function nm(f){let p=f.properties||{};return p.name||p.NAME||p.NAME_EN||p.ADMIN||'Unknown'}function countryNm(f){let p=f.properties||{};return p.admin||p.ADMIN||p.geonunit||p.sovereignt||'Unknown country'}function dist(a,b){let dx=Math.abs(a.b.cx-b.b.cx);dx=Math.min(dx,360-dx);return Math.hypot(dx*Math.cos((a.b.cy+b.b.cy)/2*Math.PI/180),a.b.cy-b.b.cy)}function adj(a,b){return !!a&&!!b&&a.id!==b.id&&dist(a,b)<Math.max(5,Math.min(22,(a.radius+b.radius)*.45+4))}
function reachable(a,b){return adj(a,b)||dist(a,b)<22}function near(c){
 if(!c)return [];
 if(neighborCache.has(c.id))return neighborCache.get(c.id);
 const bx=Math.floor((c.b.cx+180)/15),by=Math.floor((c.b.cy+90)/15),cand=[];
 for(let dx=-1;dx<=1;dx++)for(let dy=-1;dy<=1;dy++){
  const x=(bx+dx+24)%24, key=x+','+(by+dy), bucket=neighborGrid.get(key);
  if(bucket)for(const n of bucket)if(n.id!==c.id&&adj(c,n))cand.push(n);
 }
 if(!cand.length){const ranked=cs.filter(n=>n.id!==c.id).map(n=>({n,d:dist(c,n)})).filter(x=>x.d<28).sort((a,b)=>a.d-b.d).slice(0,12);for(const x of ranked)if(!cand.some(n=>n.id===x.n.id))cand.push(x.n)}
 neighborCache.set(c.id,cand);return cand
}
function buildNeighborGrid(){
 neighborGrid=new Map();neighborCache.clear();
 for(const c of cs){const x=Math.floor((c.b.cx+180)/15)%24,y=Math.floor((c.b.cy+90)/15),key=x+','+y;if(!neighborGrid.has(key))neighborGrid.set(key,[]);neighborGrid.get(key).push(c)}
}function closest(lon,lat){let x=project(lon,lat),best=0,d0=1e9;cs.forEach((c,i)=>{let d=Math.hypot(c.center[0]-x[0],c.center[1]-x[1]);if(d<d0){best=i;d0=d}});return best}
function makePath(ps){const path=new Path2D();for(const poly of ps)for(const ring of poly){if(!ring.length)continue;let q=project(ring[0][0],ring[0][1]);path.moveTo(q[0],q[1]);for(let j=1;j<ring.length;j++){q=project(ring[j][0],ring[j][1]);path.lineTo(q[0],q[1])}path.closePath()}return path}
function setup(data){cs=data.features.map(f=>{let ps=polys(f.geometry);if(!ps.length)return null;let b=bounds(ps);return{id:-1,name:nm(f),country:countryNm(f),polys:ps,b,path:makePath(ps),center:project(b.cx,b.cy),radius:Math.max(1,Math.hypot(b.maxX-b.minX,b.maxY-b.minY)/2),owner:-1,army:0,fort:0,pop:1}}).filter(c=>c&&c.name!=='Antarctica');cs.forEach((c,i)=>c.id=i);buildNeighborGrid();reset()}
function reset(){activeCapture=null;pendingTarget=-1;const ta=document.getElementById('targetAction');if(ta)ta.style.display='none';
 paused=true;ended=false;choosingStart=false;matchSeconds=0;uiClock=0;drawClock=0;lastTick=Date.now();aiClock=0;
 $('end').textContent='Resume';$('startScreen').classList.remove('hidden');$('startGame').textContent='Choose starting territory';
 zoom=1;panX=0;panY=0;cs.forEach(c=>{c.owner=-1;c.army=0;c.fort=0});
 sel=-1;gold=100;turn=1;truce=[0,0,0,0];$('overlay').classList.remove('show');
 $('mapStatus').textContent='World map ready. Tap Choose starting territory, then tap any region on the map.';
 say('Choose your own starting territory to begin.');render();draw()
}
function beginAt(id){
 if(id<0||!cs[id])return;
 cs.forEach(c=>{c.owner=-1;c.army=0;c.fort=0});
 const starts=[id];cs[id].owner=0;cs[id].army=75;cs[id].fort=1;
 // Put rival starts far apart from the player and from one another.
 while(starts.length<4){
  let best=-1,bestScore=-1;
  for(let tries=0;tries<Math.min(cs.length,900);tries++){
   const cand=Math.floor(Math.random()*cs.length);if(starts.includes(cand))continue;
   const c=cs[cand];if(c.b.cx<-180||c.b.cx>180)continue;
   let score=Infinity;
   for(const sid of starts){const q=cs[sid],dx=Math.min(Math.abs(c.b.cx-q.b.cx),360-Math.abs(c.b.cx-q.b.cx))*Math.cos((c.b.cy+q.b.cy)/2*Math.PI/180),dy=c.b.cy-q.b.cy;score=Math.min(score,Math.hypot(dx,dy))}
   if(score>bestScore){bestScore=score;best=cand}
  }
  if(best<0)break;starts.push(best);cs[best].owner=starts.length-1;cs[best].army=60+Math.floor(Math.random()*15);cs[best].fort=1;
 }
 starts.forEach((sid,p)=>near(cs[sid]).filter(c=>c.owner===-1).slice(0,3).forEach(c=>{c.owner=p;c.army=18+Math.floor(Math.random()*10)}));
 sel=id;gold=100;turn=1;ended=false;paused=false;choosingStart=false;matchSeconds=0;lastTick=Date.now();aiClock=0;
 $('startScreen').classList.add('hidden');$('mapStatus').textContent='';say('Campaign started from '+cs[id].name+'.');render();draw()
}
function fmtTime(sec){sec=Math.floor(sec);return String(Math.floor(sec/60)).padStart(2,'0')+':'+String(sec%60).padStart(2,'0')}function income(){return Math.max(1,Math.floor(cs.reduce((n,c)=>n+(c.owner===0?1:0),0)/5))}function render(){let owned=0,troops=0;for(const c of cs)if(c.owner===0){owned++;troops+=c.army}$('owned').textContent=owned;$('troops').textContent=Math.floor(troops);$('income').textContent='+'+income();$('gold').textContent=Math.floor(gold);$('turn').textContent=turn;$('timer').textContent=fmtTime(matchSeconds);let c=cs[sel];$('countryName').textContent=c?c.name+' — '+c.country:'No country selected';$('countryInfo').textContent=c?`${c.country} • ${c.owner<0?'Neutral':factions[c.owner]} • ${Math.floor(c.army)} troops • Fort ${c.fort} • ${near(c).length} nearby regions`:'Tap a region to inspect it.';$('taxlabel').textContent=['Low','Normal','High'][+$('tax').value];$('attackPctLabel').textContent=$('attackPct').value+'%';$('end').textContent=paused?'Resume':'Pause';const ranks=[0,1,2,3].map(p=>({p,n:0,t:0}));for(const x of cs)if(x.owner>=0){ranks[x.owner].n++;ranks[x.owner].t+=x.army}ranks.forEach(r=>r.t=Math.floor(r.t));ranks.sort((a,b)=>b.n-a.n||b.t-a.t);$('leaderboard').innerHTML=ranks.map((r,i)=>`<div class="rank-row"><span class="rank-left"><b>${i+1}.</b><i class="rank-dot" style="background:${colors[r.p]}"></i>${factions[r.p]}</span><span>${r.n} regions · ${r.t.toLocaleString()} troops</span></div>`).join('');$('recruit').disabled=ended||!c||c.owner!==0||gold<20;$('fortify').disabled=ended||!c||c.owner!==0||gold<35||c.fort>=3;$('expand').disabled=ended||!c||c.owner!==0;$('attack').disabled=ended||!c||c.owner!==0;$('end').disabled=ended}
let activeCapture=null,pendingTarget=-1;
let drawPending=false;function draw(){if(drawPending)return;drawPending=true;requestAnimationFrame(()=>{drawPending=false;drawNow()})}function drawNow(){ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,W,H);ctx.fillStyle='#091522';ctx.fillRect(0,0,W,H);ctx.save();ctx.setTransform(zoom,0,0,zoom,panX,panY);ctx.strokeStyle='#1b2a3d';ctx.lineWidth=1/zoom;for(let lon=-150;lon<=150;lon+=30){let x=project(lon,0)[0];ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke()}for(let lat=-60;lat<=60;lat+=30){let y=project(0,lat)[1];ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}const left=-panX/zoom,top=-panY/zoom,right=(W-panX)/zoom,bottom=(H-panY)/zoom;for(const c of cs){const b=c.b;if((b.maxX+180)/360*W<left||(b.minX+180)/360*W>right||(90-b.maxY)/180*H>bottom||(90-b.minY)/180*H<top)continue;ctx.fillStyle=c.owner<0?'#30445a':colors[c.owner];ctx.globalAlpha=c.owner<0?.88:1;ctx.fill(c.path,'evenodd');ctx.globalAlpha=1;ctx.strokeStyle=c.id===sel?'#ffffff':'#091522';ctx.lineWidth=(c.id===sel?2.5:.65)/zoom;ctx.stroke(c.path);if(zoom>=1.45&&c.owner>=0&&c.army>=35){let[x,y]=c.center;ctx.beginPath();ctx.fillStyle='#07111de8';ctx.arc(x,y,10/zoom,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.font=`bold ${11/zoom}px system-ui`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(Math.floor(c.army),x,y)}}if(activeCapture){const t=cs[activeCapture.to];if(t){const [x,y]=t.center,progress=Math.max(0,Math.min(1,activeCapture.elapsed/activeCapture.duration));ctx.globalAlpha=1;ctx.strokeStyle='#ffe08a';ctx.lineWidth=4/zoom;ctx.beginPath();ctx.arc(x,y,Math.max(14,t.radius*.28),-Math.PI/2,-Math.PI/2+Math.PI*2*progress);ctx.stroke();ctx.fillStyle='#07111df2';ctx.fillRect(x-38/zoom,y+17/zoom,76/zoom,8/zoom);ctx.fillStyle='#66e6b5';ctx.fillRect(x-38/zoom,y+17/zoom,76/zoom*progress,8/zoom);}}ctx.restore();$('zoomLabel').textContent=Math.round(zoom*100)+'%'}
function ringHit(x,y,r){let ins=false;for(let i=0,j=r.length-1;i<r.length;j=i++){let[xi,yi]=r[i],[xj,yj]=r[j];if(((yi>y)!=(yj>y))&&x<(xj-xi)*(y-yi)/(yj-yi+1e-10)+xi)ins=!ins}return ins}function hit(x,y){let lon=x/W*360-180,lat=90-y/H*180;for(let i=cs.length-1;i>=0;i--){const c=cs[i];if(lon<c.b.minX||lon>c.b.maxX||lat<c.b.minY||lat>c.b.maxY)continue;for(const p of c.polys){if(!p.length||!ringHit(lon,lat,p[0]))continue;let hole=false;for(let j=1;j<p.length;j++)if(ringHit(lon,lat,p[j]))hole=!hole;if(!hole)return i}}return-1}
function attackCountry(from,to,owner){let a=cs[from],d=cs[to];if(a.owner!==owner||!reachable(a,d))return false;let stance=owner===0?$('stance').value:'balanced';let ratio=owner===0?(+$('attackPct').value/100):(stance==='military'?.72:stance==='growth'?.58:.64);let force=Math.floor(a.army*ratio);if(force<3){say('Not enough troops. Wait for reinforcements.');return false}a.army-=force;let defense=d.army+d.fort*10;let attackPower=force*(0.88+Math.random()*0.28);let defendPower=defense*(0.9+Math.random()*0.22);if(attackPower>defendPower){d.owner=owner;d.army=Math.max(2,Math.floor((attackPower-defendPower)*.68));d.fort=Math.max(0,d.fort-1);if(owner===0)say('Captured '+d.name+'!')}else{d.army=Math.max(1,Math.floor(defense-force*.42));if(owner===0)say('Attack failed. Defenders held '+d.name+'.')}return true}
function hideTargetAction(){pendingTarget=-1;$('targetAction').style.display='none'}
function showTargetAction(i){const c=cs[i];pendingTarget=i;$('targetTitle').textContent='Attack '+c.name+'?';$('targetDetail').textContent=(c.owner<0?'Neutral territory':factions[c.owner]+' territory')+' · '+Math.floor(c.army)+' defending troops · '+$('attackPct').value+'% of your army will be sent';$('targetAction').style.display='block'}
function choose(i){if(i<0)return;if(choosingStart){beginAt(i);return}if(ended)return;let c=cs[i];if(c.owner===0){sel=i;hideTargetAction();render();draw();say(c.name+' selected. Now tap a neutral or rival region, then confirm Attack.');return}if(sel<0||cs[sel].owner!==0){say('Select one of your own regions first.');return}if(activeCapture){say('A capture is already in progress. Wait for it to finish.');return}if(!reachable(cs[sel],c)){say('That region is too far away. Choose a neighboring region.');return}showTargetAction(i);render();draw();say('Target selected: '+c.name+'. Tap Attack to begin live capture.')}
function startPlayerCapture(from,to){if(ended||paused)return say('Resume the game before attacking.');if(activeCapture)return say('A capture is already in progress.');const a=cs[from],d=cs[to];if(!a||!d||a.owner!==0||d.owner===0||!reachable(a,d))return say('Choose one of your regions and a reachable neutral or enemy region.');const ratio=+$('attackPct').value/100,force=Math.floor(a.army*ratio);if(force<3)return say('Not enough troops. Wait for reinforcements.');a.army-=force;const attackPower=force*(0.88+Math.random()*0.28),defensePower=(d.army+d.fort*10)*(0.9+Math.random()*0.22);const duration=Math.max(2.2,Math.min(7,1.8+(d.army+d.fort*10)/Math.max(8,force)*2.4));activeCapture={from,to,owner:0,force,attackPower,defensePower,elapsed:0,duration,targetName:d.name};hideTargetAction();say('Forces advancing on '+d.name+'… capture in progress.');render();draw()}
function finishPlayerCapture(){if(!activeCapture)return;const battle=activeCapture,c=cs[battle.to];if(c&&battle.attackPower>battle.defensePower){c.owner=0;c.army=Math.max(2,Math.floor((battle.attackPower-battle.defensePower)*.68));c.fort=Math.max(0,c.fort-1);say('Captured '+c.name+'! Your flag now controls the region.')}else if(c){c.army=Math.max(1,Math.floor(battle.defensePower-battle.force*.42));say('Capture failed — defenders held '+c.name+'. Your attacking force was lost.')}activeCapture=null;render();draw();checkEnd()}

function expand(){if(sel<0||cs[sel].owner!==0)return say('Select one of your own green regions first.');let o=near(cs[sel]).filter(c=>c.owner===-1&&reachable(cs[sel],c)).sort((a,b)=>a.army-b.army);if(!o.length){const fallback=cs.filter(c=>c.owner===-1&&reachable(cs[sel],c)).sort((a,b)=>dist(cs[sel],a)-dist(cs[sel],b));o=fallback.slice(0,1)}if(!o.length)return say('No neutral region is close enough to this region. Select another green region or zoom out and choose a border region.');startPlayerCapture(sel,o[0].id);return true}
function attack(){if(pendingTarget>=0){startPlayerCapture(sel,pendingTarget);return}if(sel<0||cs[sel].owner!==0)return say('Select one of your regions first.');let o=near(cs[sel]).filter(c=>c.owner!==0&&(c.owner<0||truce[c.owner]<=turn)&&reachable(cs[sel],c)).sort((a,b)=>a.army+a.fort*8-b.army-b.fort*8);if(!o.length)return say('No reachable target nearby. Expand first or choose another border region.');showTargetAction(o[0].id);render()}
function recruit(){if(sel<0||cs[sel].owner!==0)return;const c=cs[sel],cost=20;if(gold<cost)return say('Recruiting costs 20 gold. End a turn to earn more.');gold-=cost;c.army+=10;render();draw();say('Recruited 10 troops in '+c.name+' for 20 gold.')}
function fortify(){if(sel<0||cs[sel].owner!==0)return;let c=cs[sel];if(gold<35)return say('Fortify costs 35 gold.');if(c.fort>=3)return say('Maximum fort level reached.');gold-=35;c.fort++;c.army+=5;render();draw();say(c.name+' fortified: +5 troops and stronger defense.')}
function offerTruce(){if(gold<50)return say('A truce costs 50 gold.');let ps=[1,2,3].filter(p=>cs.some(c=>c.owner===p)&&truce[p]<=turn);if(!ps.length)return say('No rival available for a truce.');let p=ps.sort((a,b)=>cs.filter(c=>c.owner===a).length-cs.filter(c=>c.owner===b).length)[0];gold-=50;truce[p]=turn+3;render();say('Truce with '+factions[p]+' for 3 turns.')}
function ai(p){
 let own=cs.filter(c=>c.owner===p);if(!own.length)return;
 const diff=$('difficulty').value;
 own.forEach(c=>{c.army+=Math.max(0.2,(diff==='hard'?1.15:diff==='easy'?.55:.8));});
 if(truce[p]>turn)return;
 // Prefer border regions with enough troops, and score targets by weakness and strategic value.
 const borders=own.filter(c=>near(c).some(n=>n.owner!==p)).sort((a,b)=>b.army-a.army);
 const from=borders.find(c=>c.army>(diff==='hard'?18:diff==='easy'?30:24));if(!from)return;
 const opts=near(from).filter(c=>c.owner!==p&&!(c.owner===0&&truce[p]>turn));
 opts.sort((a,b)=>targetScore(a)-targetScore(b));
 const target=opts[0];if(!target)return;
 const threshold=diff==='hard'?1.03:diff==='easy'?1.42:1.2;
 if(from.army>=(target.army+target.fort*10+4)*threshold){
   const previous=target.owner;attackCountry(from.id,target.id,p);
   if(target.owner===p&&previous!==p&&p!==0)say(factions[p]+' captured '+target.name+'.');
 }
 function targetScore(c){return c.army+c.fort*12-(c.owner===-1?7:0)-(c.owner===0?2:0)-near(c).filter(n=>n.owner===p).length*.15;}
}
function checkEnd(){let mine=cs.some(c=>c.owner===0),enemy=cs.some(c=>c.owner>0),neutral=cs.some(c=>c.owner===-1);if(!enemy&&!neutral)finish(true,'You have conquered every mapped region.');else if(!mine)finish(false,'Your empire fell. Fortify borders and manage your economy before ending turns.')}
function finish(w,t){ended=true;$('endTitle').textContent=w?'World conquered!':'Defeat';$('endText').textContent=t;$('overlay').classList.add('show')}
function endTurn(){paused=!paused;lastTick=Date.now();$('end').textContent=paused?'Resume':'Pause';say(paused?'Game paused.':'Battle resumed.');}
function realtimeTick(){
 const now=Date.now(),rawDt=Math.min(0.5,Math.max(0,(now-lastTick)/1000));lastTick=now;
 if(!ended&&!paused&&!choosingStart){
  const speed=+$('speed').value,dt=rawDt*speed;aiClock+=dt;matchSeconds+=rawDt;if(activeCapture){activeCapture.elapsed+=dt;if(activeCapture.elapsed>=activeCapture.duration)finishPlayerCapture();}
  const tax=+$('tax').value,stance=$('stance').value;let mineCount=0;
  for(const c of cs)if(c.owner>=0){
   if(c.owner===0)mineCount++;
   const rate=c.owner===0?(stance==='military'?1.35:stance==='growth'?.9:1):.8;
   c.army=Math.min(99999,c.army+dt*rate*(tax===0&&c.owner===0?1.1:tax===2&&c.owner===0?.8:1));
  }
  gold+=dt*Math.max(.25,mineCount/18)*(tax===0?.65:tax===2?1.5:1);
  if(aiClock>=2.4){aiClock=0;for(let p=1;p<=3;p++)ai(p);turn++;}
  checkEnd();
 }
 uiClock+=rawDt;drawClock+=rawDt;
 if(uiClock>=1){uiClock=0;render()}
 if(drawClock>=.65){drawClock=0;draw()}
}

function localPoint(e){const r=cv.getBoundingClientRect();return{x:(e.clientX-r.left)/r.width*W,y:(e.clientY-r.top)/r.height*H}}
function clampView(){zoom=Math.max(1,Math.min(8,zoom));const minX=W-W*zoom,maxX=0,minY=H-H*zoom,maxY=0;panX=Math.max(minX,Math.min(maxX,panX));panY=Math.max(minY,Math.min(maxY,panY));if(zoom===1){panX=0;panY=0}}
function setZoom(next,cx=W/2,cy=H/2){const z=Math.max(1,Math.min(8,next));const wx=(cx-panX)/zoom,wy=(cy-panY)/zoom;zoom=z;panX=cx-wx*zoom;panY=cy-wy*zoom;clampView();draw()}
$('zoomIn').onclick=()=>setZoom(zoom*1.25);$('zoomOut').onclick=()=>setZoom(zoom/1.25);$('zoomReset').onclick=()=>{zoom=1;panX=0;panY=0;draw()};
cv.addEventListener('wheel',e=>{e.preventDefault();const p=localPoint(e);setZoom(zoom*(e.deltaY<0?1.15:1/1.15),p.x,p.y)},{passive:false});
cv.addEventListener('pointerdown',e=>{cv.setPointerCapture(e.pointerId);const p=localPoint(e);pointers.set(e.pointerId,p);if(pointers.size===1){const source=hit((p.x-panX)/zoom,(p.y-panY)/zoom);gesture={type:source>=0&&cs[source].owner===0?'attack-drag':'single',source,id:e.pointerId,startX:p.x,startY:p.y,lastX:p.x,lastY:p.y,moved:false,panX,panY}}else if(pointers.size===2){const a=[...pointers.values()];gesture={type:'pinch',distance:Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y),zoom,midX:(a[0].x+a[1].x)/2,midY:(a[0].y+a[1].y)/2,worldX:(((a[0].x+a[1].x)/2)-panX)/zoom,worldY:(((a[0].y+a[1].y)/2)-panY)/zoom}}});
cv.addEventListener('pointermove',e=>{if(!pointers.has(e.pointerId)||!gesture)return;const p=localPoint(e);pointers.set(e.pointerId,p);if(pointers.size>=2){const a=[...pointers.values()];if(gesture.type!=='pinch'){gesture={type:'pinch',distance:Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y),zoom,midX:(a[0].x+a[1].x)/2,midY:(a[0].y+a[1].y)/2,worldX:(((a[0].x+a[1].x)/2)-panX)/zoom,worldY:(((a[0].y+a[1].y)/2)-panY)/zoom};return}const d=Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y),mx=(a[0].x+a[1].x)/2,my=(a[0].y+a[1].y)/2;zoom=Math.max(1,Math.min(8,gesture.zoom*(d/(gesture.distance||1))));panX=mx-gesture.worldX*zoom;panY=my-gesture.worldY*zoom;clampView();draw();return}if(gesture.type==='single'||gesture.type==='attack-drag'){const dx=p.x-gesture.startX,dy=p.y-gesture.startY;if(Math.hypot(dx,dy)>7)gesture.moved=true;if(gesture.type==='single'&&gesture.moved){panX=gesture.panX+dx;panY=gesture.panY+dy;clampView();draw()}gesture.lastX=p.x;gesture.lastY=p.y}});
function finishPointer(e){if(!pointers.has(e.pointerId))return;const p=pointers.get(e.pointerId);if(pointers.size===1&&gesture){const x=(p.x-panX)/zoom,y=(p.y-panY)/zoom;if(gesture.type==='attack-drag'&&gesture.moved){const target=hit(x,y);if(target>=0&&target!==gesture.source){sel=gesture.source;if(reachable(cs[gesture.source],cs[target])){startPlayerCapture(gesture.source,target)}else say('Drag to a closer neighboring region, or use Expand.')}}else if(gesture.type==='single'&&!gesture.moved){choose(hit(x,y))}}pointers.delete(e.pointerId);if(pointers.size===0)gesture=null;else if(pointers.size===1){const [id,q]=[...pointers.entries()][0];gesture={type:'single',id,startX:q.x,startY:q.y,lastX:q.x,lastY:q.y,moved:true,panX,panY}}}
cv.addEventListener('pointerup',finishPointer);cv.addEventListener('pointercancel',e=>{pointers.delete(e.pointerId);gesture=null});$('expand').onclick=expand;$('attack').onclick=attack;$('confirmAttack').onclick=()=>{if(pendingTarget>=0)startPlayerCapture(sel,pendingTarget)};$('cancelAttack').onclick=hideTargetAction;$('fortify').onclick=fortify;$('recruit').onclick=recruit;$('truce').onclick=offerTruce;$('end').onclick=endTurn;$('restart').onclick=reset;$('again').onclick=reset;$('tax').oninput=render;$('attackPct').oninput=render;$('startGame').onclick=()=>{
 if(!cs.length){$('mapStatus').textContent='Still loading map — please wait.';return}
 if(!choosingStart&&sel>=0&&!ended){$('startScreen').classList.add('hidden');paused=false;lastTick=Date.now();return}
 choosingStart=true;paused=true;sel=-1;$('startScreen').classList.add('hidden');
 say('START LOCATION: Tap any territory on the map.');$('countryName').textContent='Choose a starting territory';$('countryInfo').textContent='Tap any region to begin your campaign there.';render();draw()
};setInterval(realtimeTick,100);
async function loadWorldMap(){
 say('Loading world map…');$('mapStatus').textContent='Downloading world map… first load may take a little while.';
 let lastError=null;
 for(const source of urls){
  try{
   say('Trying map source '+(urls.indexOf(source)+1)+' of '+urls.length+'…');$('mapStatus').textContent='Trying map source '+(urls.indexOf(source)+1)+' of '+urls.length+'…';
   const response=await fetch(source,{cache:'force-cache'});
   if(!response.ok)throw new Error('HTTP '+response.status);
   const data=await response.json();
   if(!data||!Array.isArray(data.features)||!data.features.length)throw new Error('The map file did not contain geographic features.');
   setup(data);return;
  }catch(error){lastError=error;console.warn('Map source failed:',source,error)}
 }
 say('Could not download the world map ('+(lastError&&lastError.message?lastError.message:'network error')+'). Check your internet connection, then tap Retry map.');$('mapStatus').textContent='Map download failed. Check internet and retry.';
 ctx.fillStyle='#fff';ctx.font='bold 26px system-ui';ctx.textAlign='center';ctx.fillText('World map could not load',W/2,H/2-20);
 ctx.font='16px system-ui';ctx.fillStyle='#b8c9dc';ctx.fillText('Connect to the internet, then retry.',W/2,H/2+16);
 let retry=document.getElementById('retryMap');if(!retry){retry=document.createElement('button');retry.id='retryMap';retry.className='btn primary widebtn';retry.textContent='Retry map download';retry.onclick=()=>{retry.remove();loadWorldMap()};document.querySelector('.wide').appendChild(retry)}
}
loadWorldMap();
})();
</script></body></html>
